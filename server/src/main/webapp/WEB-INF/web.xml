<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Client Servlet Mapping -->
    <servlet>
        <servlet-name>ClientServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ClientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientServlet</servlet-name>
        <url-pattern>/clients</url-pattern>
    </servlet-mapping>

    <!-- Courier Servlet Mapping -->
    <servlet>
        <servlet-name>CourierServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.CourierServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourierServlet</servlet-name>
        <url-pattern>/couriers</url-pattern>
    </servlet-mapping>

    <!-- Delivery Order Servlet Mapping -->
    <servlet>
        <servlet-name>DeliveryOrderServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.DeliveryOrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeliveryOrderServlet</servlet-name>
        <url-pattern>/delivery-orders</url-pattern>
    </servlet-mapping>

    <!-- Shipment Servlet Mapping -->
    <servlet>
        <servlet-name>ShipmentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ShipmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShipmentServlet</servlet-name>
        <url-pattern>/shipments</url-pattern>
    </servlet-mapping>

</web-app>